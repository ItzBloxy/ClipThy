<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipThy</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ApplicationIcon>ClipThy.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>ClipThy</Product>
    <AssemblyTitle>ClipThy</AssemblyTitle>
    <Description>Instant replay for the Windows desktop: keeps the last seconds of screen, system audio and microphone in memory and saves them as an MP4 on a hotkey.</Description>
    <Authors>Bloxy</Authors>
    <Copyright>Copyright (c) 2026 Bloxy</Copyright>
    <RepositoryUrl>https://github.com/ItzBloxy/ClipThy</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
